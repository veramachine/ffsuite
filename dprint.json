// imi's, with what this repository's files keep. Its plugins the latest (the owner's: 2026-10-07;
// `just dprint-update`), clean on dprint 0.54.0 (nixpkgs') and 0.60.1 (the action's). The markdown
// plugin joins a line opening with `--` or a list marker (`500)`) to the one before: break earlier.
{
  "markdown": {
    "textWrap": "maintain",
    // the repository's emphasis: the plugin's defaults are underscores
    "emphasisKind": "asterisks",
    "strongKind": "asterisks"
  },
  // uv's own: `uv add` and `uv version` write four spaces
  "toml": { "indentWidth": 4 },
  "excludes": [
    // a finished record it cannot round-trip: a line's `>=` read as a quote, `> =`
    "docs/ffman-python.md",
    // git-cliff's (cliff.toml): regenerated at each release, never edited
    "packages/*/CHANGELOG.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ]
}
